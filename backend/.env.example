# Copia este archivo a .env (no se versiona) y llena los valores.

# Supabase (proyecto weveh): copia el host del pooler en modo sesión desde Connect → Session pooler
WEVEH_DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres
WEVEH_DB_USUARIO=postgres.yrqjxgpskkhjhkkthimm
WEVEH_DB_CLAVE=
# Conexiones del backend a la base (7 en Render). Supabase acepta 15 en total y en un despliegue Render usa 14
# (instancia vieja y nueva). En local usa 2: Flyway necesita dos conexiones para aplicar una migración pendiente
# (con 1 se queda esperándose a sí mismo). Apaga el backend local mientras Render despliega para no pasar de 15.
WEVEH_DB_POOL=2

# Cuentas con Supabase Auth (docs/adr/0005). URL pública del proyecto (por defecto la de weveh)
WEVEH_SUPABASE_URL=https://yrqjxgpskkhjhkkthimm.supabase.co
# Llave service_role (Project Settings → API Keys). SECRETA: solo aquí, nunca en la app ni en el repo
WEVEH_SUPABASE_SERVICE_ROLE=

# Mecánico IA por OpenRouter (docs/adr/0004). La llave nunca va en la app ni en el repo.
OPENROUTER_API_KEY=
# Modelos de OpenRouter en orden de preferencia, separados por coma. Vacío = los gratuitos por defecto
# de application.yml. Ejemplo: nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free
WEVEH_IA_MODELO=

# Voz a texto del Mecánico IA con Whisper de Groq (ADR 0018, RF-MIA-11). La llave nunca va en la app ni en el repo;
# sin ella el micrófono responde "No pude entender el audio, escríbelo". El audio no se guarda.
GROQ_API_KEY=
# Vacío = whisper-large-v3-turbo (rápido). whisper-large-v3 es más preciso con micrófonos malos o ruido.
WEVEH_TRANSCRIPCION_MODELO=

# Solo desarrollo: probar la app en el navegador del PC (npx expo start --web)
WEVEH_CORS_ORIGENES=

# Resiliencia (ADR 0010): "inactivo" apaga un módulo (sus endpoints responden 503 "en mantenimiento"). Las cuentas no.
# WEVEH_MODULO_GARAJE=inactivo
# WEVEH_MODULO_CATALOGO=inactivo
# WEVEH_MODULO_MECANICOIA=inactivo

# Monitoreo (ADR 0010): proyecto weveh-backend en Sentry (organización weveh-group). Vacío = no envía nada.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Contrato OpenAPI (ADR 0012): apagado en producción; la prueba ContratoOpenApiTest lo enciende.
# WEVEH_OPENAPI=false
