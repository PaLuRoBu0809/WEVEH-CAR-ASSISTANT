# Copia este archivo a .env (no se versiona) y llena los valores.

# Supabase: cadena JDBC del pooler en modo sesión (Project Settings → Database → Connection string → JDBC)
WEVEH_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres
WEVEH_DB_USUARIO=postgres.<referencia-del-proyecto>
WEVEH_DB_CLAVE=

# IA (se usan desde la fase 3)
ANTHROPIC_API_KEY=
WEVEH_IA_MODELO=claude-opus-5-5
