{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md", "docs/arquitectura.md", "docs/api.md", "docs/datos.md"],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "deny",
      "*mvnw *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "rm *": "deny"
    },
    "webfetch": "deny",
    "external_directory": "deny"
  }
}
